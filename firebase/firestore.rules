rules_version = '2';

// Deutsch Macerası ve diğer okul uygulamaları için ortak kurallar.
// - Yalnızca doğrulanmış @alkev.k12.tr ve @stu.alkev.k12.tr Google hesapları
//   herhangi bir veriye erişebilir. Başka bir hesapla giriş yapan kişi hiçbir
//   şeyi okuyamaz ve yazamaz (kontrol sunucuda yapılır, tarayıcıda değil).
// - Öğrenci yalnızca kendi profilini ve kendi oturum kayıtlarını görür.
// - Yönetici: Firestore'da admins/{e-posta} belgesi olan okul hesabı.
//   Bu belgeyi yalnızca Firebase konsolundan ekleyebilirsiniz.
service cloud.firestore {
  match /databases/{database}/documents {

    function schoolUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('^[^@]+@(stu[.])?alkev[.]k12[.]tr$');
    }

    function isAdmin() {
      return schoolUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Yönetici listesi: kişi yalnızca kendi kaydının var olup olmadığını okuyabilir.
    match /admins/{email} {
      allow get: if schoolUser() && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    // Sınıf listesi: belge kimliği öğrencinin e-postası (küçük harf), içinde sınıf ve ad.
    // Öğretmenin verdiği listeden rapor panelinde yüklenir; yalnızca yöneticiler okur ve yazar.
    match /sinif_listesi/{email} {
      allow read, delete: if isAdmin();
      // Öğrenci kendi sınıfını okuyabilir (Haftalık Sınıf Ligi için); başkasınınkini göremez
      allow get: if schoolUser() && request.auth.token.email.lower() == email;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['sinif', 'ad', 'guncelleyen', 'guncelleme'])
        && request.resource.data.sinif is string
        && request.resource.data.sinif.size() > 0 && request.resource.data.sinif.size() <= 20
        && (!('ad' in request.resource.data) || (request.resource.data.ad is string && request.resource.data.ad.size() <= 80))
        && email.matches('^[^@]+@(stu[.])?alkev[.]k12[.]tr$');
    }

    // Sınıf Düellosu (canlı yarışma). Yalnızca yöneticiler (öğretmenler) düello açar.
    // Doğru cevaplar duels/{kod}/secret altında, yalnızca düelloyu açan öğretmen okur.
    // Öğrenci her soruya bir kez cevap verir; süreyi sunucu saati ölçer.
    function duel(code) {
      return get(/databases/$(database)/documents/duels/$(code)).data;
    }
    match /duels/{code} {
      allow get: if schoolUser();
      allow list: if false;
      allow create: if isAdmin() && request.resource.data.host == request.auth.uid;
      allow update: if isAdmin() && resource.data.host == request.auth.uid
        && request.resource.data.host == resource.data.host;
      allow delete: if false;

      match /secret/{doc} {
        allow read, write: if schoolUser() && duel(code).host == request.auth.uid;
      }
      match /players/{uid} {
        allow read: if schoolUser();
        allow create: if schoolUser() && uid == request.auth.uid
          && request.resource.data.score == 0
          && request.resource.data.email == request.auth.token.email.lower()
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && duel(code).state != 'end';
        allow update: if schoolUser() && duel(code).host == request.auth.uid;
        allow delete: if false;
      }
      match /answers/{id} {
        allow create: if schoolUser()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.qi is int && request.resource.data.choice is int
          && id == string(request.resource.data.qi) + '_' + request.auth.uid
          && duel(code).state == 'question'
          && request.resource.data.qi == duel(code).qi
          && request.resource.data.at == request.time
          && request.time <= duel(code).qStartedAt + duration.value(duel(code).seconds + 2, 's')
          && exists(/databases/$(database)/documents/duels/$(code)/players/$(request.auth.uid));
        allow read: if schoolUser() && duel(code).host == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Haftalık Sınıf Ligi: lig/{hafta}/oyuncular/{uid}, hafta ISO biçiminde (2026-W40).
    // Öğrenci yalnızca kendi satırını yazar; sınıfı öğretmenin listesinden gelir (kendisi seçemez).
    // Bir yazışta en fazla 500 XP eklenir ve iki yazış arasında en az 20 sn olmalıdır.
    function stuUser() {
      return schoolUser() && request.auth.token.email.lower().matches('^[^@]+@stu[.]alkev[.]k12[.]tr$');
    }
    function ligSatiri(hafta, uid) {
      return stuUser() && uid == request.auth.uid
        && hafta.matches('^20[0-9][0-9]-W[0-5][0-9]$')
        && request.resource.data.keys().hasOnly(['ad', 'sinif', 'xp', 'guncelleme'])
        && request.resource.data.ad is string && request.resource.data.ad.size() <= 40
        && request.resource.data.sinif == get(/databases/$(database)/documents/sinif_listesi/$(request.auth.token.email.lower())).data.sinif
        && request.resource.data.guncelleme == request.time
        && request.resource.data.xp is int;
    }
    match /lig/{hafta}/oyuncular/{uid} {
      allow read: if schoolUser();
      allow create: if ligSatiri(hafta, uid)
        && request.resource.data.xp > 0 && request.resource.data.xp <= 500;
      allow update: if ligSatiri(hafta, uid)
        && request.resource.data.xp > resource.data.xp
        && request.resource.data.xp - resource.data.xp <= 500
        && request.time > resource.data.guncelleme + duration.value(20, 's');
      allow delete: if false;
    }

    // Profil + ilerleme (XP, rozetler). Herkes yalnızca kendi belgesini yazar.
    match /users/{uid} {
      allow get: if schoolUser() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if schoolUser()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.size() <= 20;
      allow delete: if false;
    }

    // Oyun oturumları: bir kez yazılır, sonradan değiştirilemez.
    match /sessions/{id} {
      // Yalnızca öğrenci hesapları (@stu.alkev.k12.tr) oturum kaydeder; öğretmen denemeleri rapora girmez
      allow create: if schoolUser()
        && request.auth.token.email.lower().matches('^[^@]+@stu[.]alkev[.]k12[.]tr$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.app is string && request.resource.data.app.size() <= 40
        && request.resource.data.game is string && request.resource.data.game.size() <= 40
        && request.resource.data.durationSec is int
        && request.resource.data.durationSec >= 0 && request.resource.data.durationSec <= 14400
        && request.resource.data.items is list && request.resource.data.items.size() <= 300;
      allow get, list: if schoolUser() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }
  }
}
